# Ghostty terminal configuration

# macOS: Make left Option/Alt act as Meta key for terminal shortcuts (Alt+f, Alt+b, etc.)
# Right Option/Alt will still produce special characters (ń, ƒ, etc.)
macos-option-as-alt = left

# Cursor
cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor

# Scrollback
scrollback-limit = 4294967295

copy-on-select = clipboard
quit-after-last-window-closed = false
theme = IR Black
font-size = 12

# Custom key bindings
keybind = ctrl+backslash=write_scrollback_file:open
keybind = ctrl+y=paste_from_clipboard
